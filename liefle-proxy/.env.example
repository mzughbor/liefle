# Liefle reverse proxy — environment variables
# Copy to .env and adjust before deploy

# VPS public IPv4 (used to block direct IP access)
VPS_IP=195.35.1.18

# Vercel deployment origin (no trailing slash)
VERCEL_ORIGIN=https://liefle.vercel.app

# Let's Encrypt contact email
CADDY_EMAIL=admin@liefle.com

# Secret for POST/DELETE /api/domains (leave empty to disable auth in dev only)
ALLOW_API_SECRET=change-me-before-production

# SSH target for deploy.sh
DEPLOY_HOST=root@195.35.1.18
DEPLOY_PATH=/opt/liefle-proxy

# Use if normal ssh fails (pick the right key explicitly)
# SSH_OPTS=-o IdentitiesOnly=yes

# Domains you own
LIEFLE_DOMAIN=liefle.com
TEST_DOMAIN=falcon.codes
